    {
      "datasource": "{{ grafana_datasource }}",
      "description": "One row per Running DevWorkspace. Resource columns come from workspace pods; name/namespace from the DevWorkspace status exporter.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "cores"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Net RX+TX"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 21,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": true,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "11.3.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_replace(devworkspace{dw_phase=\"Running\"}, \"id\", \"$1\", \"dw_id\", \"(.+)\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_replace(sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{pod=~\"workspace.*\", namespace=~\".*-devspaces|devspaces\", container!=\"\", container!=\"POD\"}[5m])), \"id\", \"$1\", \"pod\", \"^(workspace[^-]+).*\")",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_replace(sum by (namespace, pod) (container_memory_working_set_bytes{pod=~\"workspace.*\", namespace=~\".*-devspaces|devspaces\", container!=\"\", container!=\"POD\"}), \"id\", \"$1\", \"pod\", \"^(workspace[^-]+).*\")",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_replace(sum by (namespace, pod) (rate(container_network_receive_bytes_total{pod=~\"workspace.*\", namespace=~\".*-devspaces|devspaces\"}[5m]) + rate(container_network_transmit_bytes_total{pod=~\"workspace.*\", namespace=~\".*-devspaces|devspaces\"}[5m])), \"id\", \"$1\", \"pod\", \"^(workspace[^-]+).*\")",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_replace(max by (namespace, pod) (time() - kube_pod_start_time{pod=~\"workspace.*\", namespace=~\".*-devspaces|devspaces\"}), \"id\", \"$1\", \"pod\", \"^(workspace[^-]+).*\")",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "title": "Running DevSpaces \u2014 CPU / Memory / Network / Uptime",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "id",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Value": true,
              "Value #A": true,
              "__name__": true,
              "phase": true,
              "message": true,
              "pod": true,
              "pod 1": true,
              "pod 2": true,
              "pod 3": true,
              "pod 4": true,
              "namespace 1": true,
              "namespace 2": true,
              "namespace 3": true,
              "namespace 4": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "prometheus": true,
              "service": true,
              "namespace": true,
              "exported_namespace": true,
              "dw_phase": true,
              "dw_reason": true,
              "dw_id": true,
              "managed_cluster": true
            },
            "indexByName": {
              "dw_namespace": 0,
