{% raw %}
{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Workspace detail",
      "tooltip": "",
      "type": "link",
      "url": "/d/ado-devspaces-detail/dev-spaces-workspace-detail"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Dev Spaces inventory (Running / Stopped)",
      "type": "row"
    },
    {
      "datasource": "{{ grafana_datasource }}",
      "description": "Click a DevWorkspace name to open CPU / memory / network / plugins detail.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Phase"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Running": {
                        "color": "green",
                        "text": "Running",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "Stopped": {
                        "color": "orange",
                        "text": "Stopped",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DevWorkspace"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open detail",
                    "url": "/d/ado-devspaces-detail/dev-spaces-workspace-detail?orgId=1&var-dw_namespace=${__data.fields.Namespace}&var-dw_name=${__data.fields.DevWorkspace}&var-dw_id=${__data.fields[\"Workspace ID\"]}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "countRows": true,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "devworkspace{dw_phase=~\"Running|Stopped\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Running & Stopped DevSpaces \u2014 click name for detail",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "prometheus": true,
              "service": true,
              "managed_cluster": true,
              "dw_reason": true
            },
            "indexByName": {
              "dw_namespace": 0,
              "dw_name": 1,
              "dw_id": 2,
              "dw_phase": 3
            },
            "renameByName": {
              "dw_namespace": "Namespace",
              "dw_name": "DevWorkspace",
              "dw_id": "Workspace ID",
              "dw_phase": "Phase"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": "{{ grafana_datasource }}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 15
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(devworkspace{dw_phase=\"Running\"}) or vector(0)",
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Running",
      "type": "stat"
    },
    {
      "datasource": "{{ grafana_datasource }}",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
